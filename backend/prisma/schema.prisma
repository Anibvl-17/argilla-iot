generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  CLIENT
}

enum FiringCycleExecutionType {
  PROGRAM
  DIRECT
}

enum FiringCycleStatus {
  RUNNING
  COMPLETED
  CANCELLED
  ERROR
}

enum ControllerActivityStatus {
  IDLE
  FIRING
  PAUSED
  ERROR
}

enum ConnectionStatus {
  ONLINE
  OFFLINE
}

enum OperationalStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
}

enum SwitchType {
  CONTACTOR
  SSR
}

model User {
  userId       Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?   @db.VarChar(32)
  countryCode  String?   @db.VarChar(2)
  regionCode   String?   @db.VarChar(2)
  communeCode  String?   @db.VarChar(5)
  addressLine  String?   @db.VarChar(300)
  role         UserRole  @default(CLIENT)
  createdAt    DateTime  @default(now())
  isActive     Boolean   @default(true)
  anonymizedAt DateTime?

  programs                    Program[]
  controllers                 Controller[]
  kilns                       Kiln[]
  createdSupportTickets       SupportTicket[]     @relation("SupportTicketCreatedBy")
  assignedSupportTickets      SupportTicket[]     @relation("SupportTicketAssignedTo")
  performedMaintenanceRecords MaintenanceRecord[] @relation("MaintenancePerformedBy")
}

model Program {
  programId     Int      @id @default(autoincrement())
  userId        Int
  name          String
  description   String?
  configuration Json     @db.JsonB
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [userId], onDelete: Restrict)
  firingCycles FiringCycle[]

  @@index([userId])
}

model Controller {
  controllerId          String                   @id @default(uuid())
  userId                Int?
  deviceSecretHash      String
  pairingPinHash        String?
  pairingPinExpiresAt   DateTime?
  pairingFailedAttempts Int                      @default(0)
  pairingBlockedUntil   DateTime?
  temperature           Float?
  operationalStatus     OperationalStatus        @default(OPERATIONAL)
  connectionStatus      ConnectionStatus         @default(OFFLINE)
  activityStatus        ControllerActivityStatus @default(IDLE)
  switchCurrentCapacity Int                      @default(20)
  switchType            SwitchType               @default(CONTACTOR)
  manufacturedAt        DateTime                 @default(now())
  deliveredAt           DateTime?
  firmwareVersion       String                   @default("UNKNOWN")
  firmwareUpdatedAt     DateTime?

  user               User?               @relation(fields: [userId], references: [userId], onDelete: SetNull)
  kiln               Kiln?
  maintenanceRecords MaintenanceRecord[]

  @@index([userId])
}

model Kiln {
  kilnId                      Int               @id @default(autoincrement())
  userId                      Int?
  controllerId                String?           @unique
  name                        String            @default("Mi Horno Argillá")
  liters                      Int
  phaseCount                  Int               @default(1)
  nominalVoltage              Int               @default(220)
  nominalCurrent              Int
  manufacturedAt              DateTime          @default(now())
  deliveredAt                 DateTime?
  operationalStatus           OperationalStatus @default(OPERATIONAL)
  manufacturer                String            @default("Argillá")
  heatingCircuitConfiguration Json              @db.JsonB

  user               User?               @relation(fields: [userId], references: [userId], onDelete: SetNull)
  controller         Controller?         @relation(fields: [controllerId], references: [controllerId], onDelete: SetNull)
  firingCycles       FiringCycle[]
  supportTickets     SupportTicket[]
  maintenanceRecords MaintenanceRecord[]

  @@index([userId])
}

model FiringCycle {
  firingCycleId     Int                      @id @default(autoincrement())
  kilnId            Int
  programId         Int?
  executionType     FiringCycleExecutionType
  targetTemperature Float?
  startedAt         DateTime                 @default(now())
  endedAt           DateTime?
  status            FiringCycleStatus        @default(RUNNING)
  programConfig     Json?                    @db.JsonB

  kiln      Kiln        @relation(fields: [kilnId], references: [kilnId], onDelete: Restrict)
  program   Program?    @relation(fields: [programId], references: [programId], onDelete: Restrict)
  telemetry Telemetry[]

  @@index([kilnId, startedAt])
  @@index([programId])
}

model Telemetry {
  telemetryId         Int      @id @default(autoincrement())
  firingCycleId       Int
  temperature         Float
  setpointTemperature Float
  switchState         Boolean
  stageIndex          Int?
  voltage             Float
  current             Float
  timestamp           DateTime @default(now())

  firingCycle FiringCycle @relation(fields: [firingCycleId], references: [firingCycleId], onDelete: Restrict)

  @@index([firingCycleId, timestamp])
}

model SupportReason {
  supportReasonId Int      @id @default(autoincrement())
  code            String   @unique
  name            String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supportTickets SupportTicket[]
}

model SupportTicket {
  supportTicketId  Int                 @id @default(autoincrement())
  supportReasonId  Int
  createdByUserId  Int
  assignedToUserId Int?
  kilnId           Int?
  title            String
  description      String
  status           SupportTicketStatus @default(OPEN)
  resolution       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  supportReason      SupportReason       @relation(fields: [supportReasonId], references: [supportReasonId], onDelete: Restrict)
  createdByUser      User                @relation("SupportTicketCreatedBy", fields: [createdByUserId], references: [userId], onDelete: Restrict)
  assignedToUser     User?               @relation("SupportTicketAssignedTo", fields: [assignedToUserId], references: [userId], onDelete: SetNull)
  kiln               Kiln?               @relation(fields: [kilnId], references: [kilnId], onDelete: SetNull)
  maintenanceRecords MaintenanceRecord[]

  @@index([supportReasonId])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([kilnId])
  @@index([status])
}

model MaintenanceRecord {
  maintenanceId     Int             @id @default(autoincrement())
  kilnId            Int?
  controllerId      String?
  performedByUserId Int
  supportTicketId   Int?
  type              MaintenanceType
  title             String
  workPerformed     String
  performedAt       DateTime
  createdAt         DateTime        @default(now())

  kiln            Kiln?          @relation(fields: [kilnId], references: [kilnId], onDelete: Restrict)
  controller      Controller?    @relation(fields: [controllerId], references: [controllerId], onDelete: Restrict)
  performedByUser User           @relation("MaintenancePerformedBy", fields: [performedByUserId], references: [userId], onDelete: Restrict)
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [supportTicketId], onDelete: SetNull)

  @@index([kilnId, performedAt])
  @@index([controllerId, performedAt])
  @@index([performedByUserId])
  @@index([supportTicketId])
}
