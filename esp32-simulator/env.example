# --- Conexión al broker MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=admin
MQTT_PASSWORD=admin

# --- Identidad del dispositivo simulado ---
DEVICE_UUID=esp32-001

# --- Comportamiento de la simulación ---
# Intervalo de publicación de temperatura (ms)
TEMP_INTERVAL_MS=5000
# Rango de temperatura simulada (°C)
TEMP_MIN=20
TEMP_MAX=1240
# Temperatura inicial
TEMP_START=25
